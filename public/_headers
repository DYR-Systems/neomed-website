/lab-icons/*
  Cache-Control: public, max-age=2592000

/medical-icons/*
  Cache-Control: public, max-age=2592000

/insurances/*
  Cache-Control: public, max-age=2592000

/neomed_logo.png
  Cache-Control: public, max-age=2592000

/neomed_logo.webp
  Cache-Control: public, max-age=2592000

/neomed_icon.png
  Cache-Control: public, max-age=2592000

/neomed_icon.webp
  Cache-Control: public, max-age=2592000

/neomed_text.png
  Cache-Control: public, max-age=2592000

/neomed_text.webp
  Cache-Control: public, max-age=2592000

/og-image.jpg
  Cache-Control: public, max-age=2592000

/favicon.png
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
