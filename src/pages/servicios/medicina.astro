---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Ubicacion from '../../components/Ubicacion.astro';
import '../../styles/global.css';

const benefits = [
  'Consultas de medicina general',
  'Chequeos preventivos y exámenes de laboratorio',
  'Control de enfermedades crónicas (diabetes, presión, colesterol)',
  'Medicina familiar para niños y adultos',
  'Diagnóstico y tratamiento oportuno',
  'Referencias a especialistas',
  'Seguimiento médico continuo',
  'Certificados y órdenes médicas'
];

const faqs = [
  {
    q: '¿Atienden sin cita previa?',
    a: 'Atendemos únicamente con cita previa para garantizar tiempo suficiente por paciente. Puedes agendar por WhatsApp al 7049-4362 o desde la página de agendar.',
  },
  {
    q: '¿Pueden ordenar exámenes de laboratorio?',
    a: 'Sí. Contamos con laboratorio clínico propio en la misma sede, por lo que tu médico puede ordenar y revisar tus exámenes sin que tengas que trasladarte.',
  },
  {
    q: '¿Atienden control de diabetes e hipertensión?',
    a: 'Sí. Damos seguimiento a enfermedades crónicas como diabetes, hipertensión, colesterol alto y síndrome metabólico, con apoyo de nutrición y análisis de composición corporal InBody.',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@type': 'MedicalBusiness',
  name: 'Médico general en Heredia — NeoMed',
  description:
    'Consulta de medicina general en Heredia, Costa Rica. Chequeos preventivos, control de enfermedades crónicas y medicina familiar.',
  medicalSpecialty: 'PrimaryCare',
  areaServed: { '@type': 'City', name: 'Heredia' },
};
---

<Layout
  title="Médico en Heredia | Consulta de medicina general — NeoMed"
  rawTitle={true}
  description="Médico general en Heredia, Costa Rica. Consultas, chequeos preventivos, control de diabetes e hipertensión y laboratorio clínico. Agenda tu cita al 7049-4362."
  keywords="medico Heredia, medico general Heredia, consulta medica Heredia, clinica Heredia, doctor en Heredia, chequeo medico Heredia, medicina familiar Costa Rica"
  breadcrumbs={[
    { name: 'Inicio', href: '/' },
    { name: 'Especialidades', href: '/servicios' },
    { name: 'Medicina', href: '/servicios/medicina' },
  ]}
  schema={[serviceSchema, faqSchema]}
  pageType="MedicalWebPage"
>
  <Header />
  
  <!-- Hero con imagen de fondo -->
  <section class="relative pt-32 pb-16 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/90 to-slate-800/80 z-10"></div>
      <img 
        src="/services/medicina_general.webp" 
        alt="Consulta de medicina general en NeoMed, Heredia" 
        width="1200"
        height="1800"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-[center_18%]"
      />
    </div>
    
    <div class="container mx-auto px-4 relative z-20">
      <div class="max-w-4xl">
        <a 
          href="/#servicios" 
          class="inline-flex items-center text-white/70 hover:text-white mb-8 transition-colors group"
        >
          <svg class="w-5 h-5 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Servicios
        </a>
        
        <div class="flex items-center gap-4 mb-6">
          <div class="w-16 h-16 rounded-2xl backdrop-blur-sm flex items-center justify-center" style="background-color: rgba(6, 112, 116, 0.2);">
            <svg class="w-8 h-8" style="color: rgb(10, 160, 165);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
            </svg>
          </div>
          <h1 class="font-heading text-4xl md:text-5xl font-light text-white">
            <span class="font-semibold" style="color: rgb(8, 140, 145);">Medicina general</span>
          </h1>
        </div>
        
        <p class="text-lg text-white/80 font-light leading-relaxed">
          Atención médica integral para toda la familia. Consultas,
          diagnósticos, chequeos preventivos y control de enfermedades crónicas.
        </p>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-20 bg-slate-50">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <p class="text-sm font-semibold uppercase tracking-wider mb-4" style="color: rgb(6, 112, 116);">Lo que ofrecemos</p>
        <h2 class="font-heading text-3xl md:text-4xl font-light text-slate-900 mb-12">
          Servicios de <span class="font-semibold">Medicina General</span>
        </h2>
        
        <div class="grid sm:grid-cols-2 gap-4">
          {benefits.map((benefit) => (
            <div class="flex items-start gap-3 bg-white p-6 rounded-xl border border-slate-100 hover:shadow-md transition-shadow">
              <svg class="w-6 h-6 flex-shrink-0 mt-0.5" style="color: rgb(6, 112, 116);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-slate-700 font-light">{benefit}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 bg-white border-t border-slate-100">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-heading text-3xl md:text-4xl font-light text-slate-900 mb-10 text-center">
          Preguntas <span class="font-semibold">frecuentes</span>
        </h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group bg-slate-50 rounded-2xl border border-slate-200 p-6">
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
                <h3 class="font-heading text-lg font-semibold text-slate-900">{faq.q}</h3>
                <svg class="w-5 h-5 mt-1 flex-shrink-0 text-cyan-600 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="mt-4 text-slate-600 font-light leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Ubicacion background="white" />

  <!-- CTA Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-heading text-3xl md:text-4xl font-light text-slate-900 mb-6">
          ¿Listo para cuidar tu <span class="font-semibold" style="color: rgb(6, 112, 116);">salud</span>?
        </h2>
        <p class="text-lg text-slate-500 mb-8 font-light">
          Agenda tu consulta médica y recibe atención profesional de calidad
        </p>
        <a 
          href="/agendar" 
          class="inline-flex items-centers gap-2 text-white px-10 py-4 rounded-full transition-all duration-300 hover:scale-105 text-lg font-medium shadow-lg" style="background-color: #067074;" onmouseover="this.style.backgroundColor='#088c91'" onmouseout="this.style.backgroundColor='#067074'"
        >
          <span>Agendar cita</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
